{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server-secure.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/.env.example",
      "dest": "/server-secure.js"
    },
    {
      "src": "/.gitignore",
      "dest": "/server-secure.js"
    },
    {
      "src": "/README.md",
      "dest": "/server-secure.js"
    },
    {
      "src": "/main.py",
      "dest": "/server-secure.js"
    },
    {
      "src": "/package.json",
      "dest": "/server-secure.js"
    },
    {
      "src": "/requirements.txt",
      "dest": "/server-secure.js"
    },
    {
      "src": "/security-middleware.js",
      "dest": "/server-secure.js"
    },
    {
      "src": "/session-token.js",
      "dest": "/server-secure.js"
    },
    {
      "src": "/oauth-state.js",
      "dest": "/server-secure.js"
    },
    {
      "src": "/server-secure.js",
      "dest": "/server-secure.js"
    },
    {
      "src": "/server.js",
      "dest": "/server-secure.js"
    },
    {
      "src": "/vercel.json",
      "dest": "/server-secure.js"
    },
    {
      "src": "/.github/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/scripts/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/dashboard",
      "dest": "/server-secure.js"
    },
    {
      "src": "/dashboard.html",
      "dest": "/server-secure.js"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
