# Discord-Bot (Python) und Web-Dashboard (Node.js)
# Diese Datei nach .env kopieren und echte Werte lokal eintragen.
# Niemals echte Zugangsdaten committen.

# Discord Developer Portal -> OAuth2
CLIENT_ID=deine_discord_client_id
CLIENT_SECRET=dein_discord_client_secret
REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Discord-Bot-Token (Bot muss im Developer Portal erstellt sein)
BOT_TOKEN=dein_discord_bot_token

# MongoDB Atlas oder eigene MongoDB-Instanz
MONGODB_URI=mongodb+srv://BENUTZER:PASSWORT@CLUSTER/DBNAME

# Webserver
PORT=3000
NODE_ENV=development

# Für Produktion: zufälliger, geheimer Wert mit mindestens 32 Zeichen
# Beispiel erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
